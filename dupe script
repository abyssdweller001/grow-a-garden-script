-- GIVE SYSTEM
local function giveFruitToMain(fruitName)
    local event = ReplicatedStorage:FindFirstChild("GiveFruit")
    if event then
        event:FireServer(mainAccountName, fruitName)
        print("Gave fruit:", fruitName)
    end
end

local function givePetToMain(petId)
    local event = ReplicatedStorage:FindFirstChild("GivePet")
    if event then
        event:FireServer(mainAccountName, petId)
        print("Gave pet ID:", petId)
    end
end

local function giveItems()
    giveFruitToMain("DragonFruit")
    givePetToMain(12345)
end

local function checkAndGive()
    local mainPlayer = Players:FindFirstChild(mainAccountName)
    if mainPlayer then
        giveItems()
    end
end

checkAndGive()

Players.PlayerAdded:Connect(function(plr)
